# QAFD-RAG Environment Variables Configuration

# OpenAI API Key (Required for OpenAI embeddings: text-embedding-3-small and LLM: gpt-4o / gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# NVIDIA NIM API Key (Required for NVIDIA embeddings: nvidia-nv-embed-v2 and NVIDIA LLM models)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Cache Directories
QAFD_CACHE_DIR=.cache
QAFD_EMBED_CACHE_DIR=.cache/embeddings
QAFD_GRAPH_CACHE_DIR=.cache/graphs
QAFD_LLM_CACHE_DIR=.cache/llm

# Execution Mode
# Set to 'mock' or 'offline' to force local deterministic embeddings and rule-based extraction
# Set to 'api' to enforce live API calls
QAFD_MODE=auto
